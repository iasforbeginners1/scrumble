<!DOCTYPE html>
<html>
<head>
    <title>UPPCS Scramble Test</title>
    <style>
        body { font-family: sans-serif; text-align: center; background: #2c3e50; color: white; }
        .container { margin-top: 50px; background: #34495e; padding: 20px; display: inline-block; border-radius: 10px; }
        input { padding: 10px; margin: 10px; border-radius: 5px; border: none; }
        button { padding: 10px 20px; background: #27ae60; color: white; border: none; cursor: pointer; }
    </style>
</head>
<body>

<div class="container">
    <h2>UPPCS Mind Scramble</h2>
    <p id="hint">Hint loading...</p>
    <h1 id="scrambled" style="letter-spacing: 5px; color: #f1c40f;">-----</h1>
    <input type="text" id="answerInput" placeholder="Sahi word likhen">
    <button onclick="check()">Check</button>
    <p id="msg"></p>
</div>

<script>
    const data = [
        {w: "LUCKNOW", h: "UP ki Rajdhani"},
        {w: "AKBAR", h: "Mughal Shasak"},
        {w: "GANGA", h: "UP ki sabse lambi nadi"}
    ];

    let current = 0;

    function init() {
        let word = data[current].w;
        let scrambled = word.split('').sort(() => 0.5 - Math.random()).join('');
        document.getElementById("scrambled").innerText = scrambled;
        document.getElementById("hint").innerText = "Hint: " + data[current].h;
    }

    function check() {
        let input = document.getElementById("answerInput").value.toUpperCase();
        if(input === data[current].w) {
            document.getElementById("msg").innerText = "Shabash! Sahi hai.";
            current = (current + 1) % data.length;
            setTimeout(init, 1000);
            document.getElementById("answerInput").value = "";
        } else {
            document.getElementById("msg").innerText = "Galat! Fir se try karein.";
        }
    }

    window.onload = init;
</script>

</body>
</html>
